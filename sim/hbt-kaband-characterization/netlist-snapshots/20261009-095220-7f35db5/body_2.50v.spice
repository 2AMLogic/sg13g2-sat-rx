      let ka_ap = ka_aa - ka_dd*ka_dd/(4*ka_bb)
      let ka_ok = 0
      if ka_bb > 0
        if ka_ap > 0
          let ka_ok = 1
        end
      end
      if ka_ok > 0
        let ka_ro = sqrt(ka_ap/ka_bb)
        if ka_xo > 0
          let ka_lv = ka_xo/1.332035285e+11
          let ka_cv = 1e-09
        else
          let ka_lv = 1e-15
          let ka_cv = -1/(1.332035285e+11*ka_xo)
        end
        alter rsz = ka_ro
        alter lsz = ka_lv
        alter csz = ka_cv
        destroy all
        noise v(on) vsn lin 1 2.12e+10 2.12e+10
        echo "KA_BLOCK zopt f=2"
        print @q.xqn.qnpn13g2[ic]
        let ka_isp = inoise_spectrum
        print ka_isp
        print @rsz[resistance]
        print @lsz[inductance]
        print @csz[capacitance]
      else
        echo "KA_BLOCK zopt_skip f=2"
      end
      destroy all
      alter rsz = 100
      alter lsz = 1e-15
      alter csz = 1e-09
      noise v(on) vsn lin 1 2.12e+10 2.12e+10
      echo "KA_BLOCK nz f=2 z=4"
      print @q.xqn.qnpn13g2[ic]
      let ka_isp = inoise_spectrum
      print ka_isp
      destroy all
      alter rsz = 100
      alter lsz = 1e-15
      alter csz = 7.507308636e-14
      noise v(on) vsn lin 1 2.12e+10 2.12e+10
      echo "KA_BLOCK nz f=2 z=5"
      print @q.xqn.qnpn13g2[ic]
      let ka_isp = inoise_spectrum
      print ka_isp
      destroy all
      alter rsz = 200
      alter lsz = 1.501461727e-09
      alter csz = 1e-09
      noise v(on) vsn lin 1 2.12e+10 2.12e+10
      echo "KA_BLOCK nz f=2 z=6"
      print @q.xqn.qnpn13g2[ic]
      let ka_isp = inoise_spectrum
      print ka_isp
      destroy all
      alter rsz = 50
      alter lsz = 1.126096295e-09
      alter csz = 1e-09
      noise v(on) vsn lin 1 2.12e+10 2.12e+10
      echo "KA_BLOCK nz f=2 z=7"
      print @q.xqn.qnpn13g2[ic]
      let ka_isp = inoise_spectrum
      print ka_isp
      destroy all
      alter rsz = 400
      alter lsz = 3.002923455e-09
      alter csz = 1e-09
      noise v(on) vsn lin 1 2.12e+10 2.12e+10
      echo "KA_BLOCK nz f=2 z=8"
      print @q.xqn.qnpn13g2[ic]
      let ka_isp = inoise_spectrum
      print ka_isp
      destroy all
      alter rsz = 1000
      alter lsz = 1.126096295e-08
      alter csz = 1e-09
      noise v(on) vsn lin 1 2.12e+10 2.12e+10
      echo "KA_BLOCK nz f=2 z=9"
      print @q.xqn.qnpn13g2[ic]
      let ka_isp = inoise_spectrum
      print ka_isp
      destroy all
      alter rsz = 50
      alter lsz = 1e-15
      alter csz = 1e-09
      noise v(on) vsn lin 1 2.12e+10 2.12e+10
      echo "KA_BLOCK nf50 f=2"
      print @q.xqn.qnpn13g2[ic]
      let ka_isp = inoise_spectrum
      print ka_isp
    end
  end
end
echo "KA_DECK_END"
alterparam nx_dut = 1
reset
.endc
