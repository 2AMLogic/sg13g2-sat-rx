      alter csz = 1e-09
      noise v(on) vsn lin 1 1.945e+10 1.945e+10
      echo "KA_BLOCK nz f=1 z=0"
      print @q.xqn.qnpn13g2[ic]
      let ka_isp = inoise_spectrum
