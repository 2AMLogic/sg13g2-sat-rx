{
  "netlist": "body_low_two.spice",
  "backend": "batch",
  "models": {
    "pdk": "ihp-sg13g2",
    "lib": "libs.tech/ngspice/models/cornerHBT.lib"
  },
  "corners": {
    "process": [
      "hbt_typ"
    ],
    "temperature_c": [
      27.0
    ]
  },
  "analysis": {
    "kind": "tran",
    "args": "1p 2p"
  },
  "measurements": [
    {
      "name": "lin_sentinel_v",
      "spice": ".meas tran lin_sentinel_v FIND v(p2) AT=2p",
      "unit": "V"
    }
  ],
  "options": {
    "timeout_s": 7200,
    "keep_artifacts": true
  },
  "batch": {
    "runner_version_check": "warn"
  }
}
