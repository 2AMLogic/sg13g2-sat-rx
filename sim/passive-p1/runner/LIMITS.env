# Declared preparation limits (issue #46).  Chosen and verified by the Builder
# for THIS preparation only; they are NOT an estimate for the full p1 campaign
# (3 solves at 1.0/0.5 um mesh), which must establish its own bounds first.
# Override only downward from the environment; bootstrap.sh/smoke refuse a value
# above the cap.

RUNNER_THREADS=2               # solver threads (default and hard cap)
RUNNER_BUILD_JOBS=2            # make -j cap
RUNNER_DISK_MIN_FREE_GB=6      # free space required on the prefix filesystem before launch
RUNNER_DISK_MAX_PREFIX_GB=3    # abort if the prefix grows beyond this
RUNNER_BUILD_TIMEOUT_S=1800    # whole bootstrap wall limit
RUNNER_SMOKE_TIMEOUT_S=60      # known-answer solver run wall limit
RUNNER_SMOKE_RSS_MAX_MB=1024   # summed RSS of the solver process tree

# Basis (verification host, one cold build in a prefix whose path contains spaces):
#   build wall 330 s, peak process-tree RSS 784 MB, prefix 0.68 GiB (incl. sources/build trees);
#   smoke wall 2.0 s, peak RSS 107 MB.  Limits are >= 3x the measured values.
