# Pinned public inputs for the passive-p1 openEMS runner (issue #46).
# Sourced by bootstrap.sh / probe.sh / smoke tooling.  Every entry is an
# immutable commit id or a sha256; nothing here is a branch or a "latest".
#
# Resolved 2026-10-10.  Python wheels are pinned (with hashes) in
# requirements-lock.txt (generated from requirements.in, see README).

# openEMS-Project umbrella repo = v0.37.0-rc2 / CSXCAD 0.7.0rc2.  The submodule
# commits are the repository's own gitlinks at that commit; bootstrap.sh checks
# them after checkout and aborts on any difference.
OPENEMS_PROJECT_REPO=https://github.com/thliebig/openEMS-Project.git
OPENEMS_PROJECT_COMMIT=ea3c012c688c9110973b2fdbf77b7b8aa09a099b
OPENEMS_SUBMODULE_FPARSER=4b9c845b449b520c4b8c5f23c74cd04820084f81
OPENEMS_SUBMODULE_CSXCAD=0458ee11ad711909cb32390b195079c3cff0606e
OPENEMS_SUBMODULE_OPENEMS=8f480d04e0e17a780df28e0ac12e2086be041f9e

# gds2openEMS (module version 0.3.0) = IHP SG13G2 GDSII->openEMS helper that
# run_openems.py imports.  Installed from this commit with --no-deps (its
# declared PySide6 dependency is a GUI stackup editor the driver never imports).
GDS2OPENEMS_REPO=https://github.com/VolkerMuehlhaus/openems_ihp_sg13g2.git
GDS2OPENEMS_COMMIT=b67d46a29405c4e0396716a627395ed92000455b

# IHP-Open-PDK v0.3.0 (tag peels to this commit; the same id as IHP_PDK_COMMIT
# in .github/workflows/ci.yml).  Only the subtrees the driver reads are fetched
# (sparse checkout) into <prefix>/pdk/IHP-Open-PDK/ihp-sg13g2 and never modified.
IHP_PDK_REPO=https://github.com/IHP-GmbH/IHP-Open-PDK.git
IHP_PDK_COMMIT=5cccb161f7492697cfa52eb14dc03beb00bdca9e
IHP_PDK_SPARSE="ihp-sg13g2/libs.tech/klayout ihp-sg13g2/libs.tech/ngspice/models"

# ngspice 46, same tarball + checksum + configure flags as the CI sim-smoke job.
NGSPICE_URL=https://downloads.sourceforge.net/project/ngspice/ng-spice-rework/old-releases/46/ngspice-46.tar.gz
NGSPICE_SHA256=a0d1699af1940b06649276dcd6ff5a566c8c0cad01b2f7b5e99dedbb4d64c19b
NGSPICE_CONFIGURE_FLAGS="--disable-debug --without-x"

# Headless KLayout is NOT built here (a Qt-less source build is far outside the
# preparation limits).  The system `klayout` must be on PATH; its version is
# recorded.  Oldest version the pinned driver has been run with:
KLAYOUT_MIN_VERSION=0.28

# System (apt) build prerequisites, reported by name when missing.  The runner
# never installs them (no root).  Debian/Ubuntu package names:
SYSTEM_PACKAGES="build-essential cmake git pkg-config python3-dev python3-venv cython3 libhdf5-dev libvtk9-dev libboost-all-dev libcgal-dev libtinyxml-dev bison flex libreadline-dev klayout curl"
