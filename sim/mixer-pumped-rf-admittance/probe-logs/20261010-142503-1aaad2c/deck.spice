meas tran rc_i_base_x_l_c INTEG pc from=8e-08 to=1.6e-07
meas tran rc_i_base_x_l_s INTEG ps from=8e-08 to=1.6e-07
echo "MARK rc_i_base_x_l_c=$&rc_i_base_x_l_c rc_i_base_x_l_s=$&rc_i_base_x_l_s"
let pc = v(krs)*cos(wu*time)
