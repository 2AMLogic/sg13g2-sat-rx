meas tran rc_t_base_x_u_s INTEG ps from=8e-08 to=1.6e-07
echo "MARK rc_t_base_x_u_c=$&rc_t_base_x_u_c rc_t_base_x_u_s=$&rc_t_base_x_u_s"
