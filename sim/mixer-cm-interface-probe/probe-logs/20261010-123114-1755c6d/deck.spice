meas tran dut_u2_c INTEG dut_c from=8e-08 to=1.2e-07
meas tran dut_u2_s INTEG dut_s from=8e-08 to=1.2e-07
echo "MARK x_dut_u2_c=$&dut_u2_c x_dut_u2_s=$&dut_u2_s"
