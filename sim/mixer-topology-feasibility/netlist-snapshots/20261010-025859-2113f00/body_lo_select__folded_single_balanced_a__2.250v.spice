let mf_flifa_im = 2 * mean((v(if_out)) * mfw * sin(mfph)) * mfs
let mfph = 2 * pi * 1050000000.0 * (time - 2e-08)
let mf_flifb_re = 2 * mean((v(if_out)) * mfw * cos(mfph)) * mfs
let mf_flifb_im = 2 * mean((v(if_out)) * mfw * sin(mfph)) * mfs
let mfph = 2 * pi * 16750000000.0 * (time - 2e-08)
let mf_fllorf_re = 2 * mean((v(rf_port)) * mfw * cos(mfph)) * mfs
let mf_fllorf_im = 2 * mean((v(rf_port)) * mfw * sin(mfph)) * mfs
