let mf_l = length(time)
let mfw = (time ge 1.99995e-08) * (time lt 3.99995e-08)
let mf_n = mean(mfw) * mf_l
let mfs = mf_l / mf_n
let mf_prail = mean(v(vdd) * (0 - i(vdd)) * mfw) * mfs
let mfph = 2 * pi * 20200000000.0 * (time - 2e-08)
let mf_lodiff_re = 2 * mean((v(lo_p)-v(lo_n)) * mfw * cos(mfph)) * mfs
let mf_lodiff_im = 2 * mean((v(lo_p)-v(lo_n)) * mfw * sin(mfph)) * mfs
let mfph = 2 * pi * 1000000000.0 * (time - 2e-08)
let mf_if_re = 2 * mean((v(if_out)) * mfw * cos(mfph)) * mfs
let mf_if_im = 2 * mean((v(if_out)) * mfw * sin(mfph)) * mfs
let mfph = 2 * pi * 20200000000.0 * (time - 2e-08)
let mf_loif_re = 2 * mean((v(if_out)) * mfw * cos(mfph)) * mfs
let mf_loif_im = 2 * mean((v(if_out)) * mfw * sin(mfph)) * mfs
let mfph = 2 * pi * 20200000000.0 * (time - 2e-08)
let mf_lorf_re = 2 * mean((v(rf_port)) * mfw * cos(mfph)) * mfs
let mf_lorf_im = 2 * mean((v(rf_port)) * mfw * sin(mfph)) * mfs
let mfph = 2 * pi * 950000000.0 * (time - 2e-08)
let mf_flifa_re = 2 * mean((v(if_out)) * mfw * cos(mfph)) * mfs
let mf_flifa_im = 2 * mean((v(if_out)) * mfw * sin(mfph)) * mfs
