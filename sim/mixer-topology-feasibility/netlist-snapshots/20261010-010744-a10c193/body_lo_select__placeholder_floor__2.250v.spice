alterparam flo = 16700000000.0
alterparam vrf1 = 0.0006324555320336759
alterparam vrf2 = 0.0
alterparam vlo = 0.0282842712474619
reset
op
let mf_dcirail = 0 - i(vdd)
let mf_dc_vce_q1 = v(c_q1)-v(e_q1)
let mf_dc_vbe_q1 = v(b_q1)-v(e_q1)
let mf_dc_ic_q1 = i(vic_q1)
print mf_dcirail
print mf_dc_vce_q1
print mf_dc_vbe_q1
print mf_dc_ic_q1
tran 1e-12 4e-08 0 1e-12
