*.raw
*.log
*.vcd
*.vvp
__pycache__/
.DS_Store

# sim/ harness: per-corner ngspice logs under corners/ are committed evidence
# (append-only record trail), so they escape the *.log rule.
!sim/*/corners/**/*.log
sim/build/
# sim/harness/cli.py's actual scratch-workdir defaults (per experiment, not
# the single top-level sim/build/ above): "_build" (cmd_run's generated-deck
# scratch dir) and "_selftest" (cmd_selftest's normal/sabotaged run dirs).
# Disposable by runner.py's own docstring ("workdir holds the generated deck
# (scratch, disposable)") -- never evidence, unlike sim/*/corners/**/*.log.
sim/*/_build/
sim/*/_selftest/
# local klt install, created by the setup script
.venv/
